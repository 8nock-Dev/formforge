# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://formforge:formforge_secret@localhost:5432/formforge

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# ─── Server ──────────────────────────────────────────────
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:5174

# ─── App URL (used in email links & redirect pages) ──────
APP_URL=http://localhost:5174

# ─── Email notifications (optional) ─────────────────────
# Leave SMTP_HOST blank to disable email — everything else still works
# Works with Gmail (App Password), SendGrid, Mailgun, Resend, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=FormForge <your@gmail.com>
